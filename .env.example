# ===== EasyTV Backend 环境配置 =====
# 复制为 .env 并按需修改：cp .env.example .env
# 本文件为占位示例，不含任何真实凭据；真实 .env 已被 git 忽略，切勿提交。

# 服务端口
PORT=8383

# 调试模式（true 输出更多日志；生产保持 false）
DEBUG=false

# ===== 数据库（easytv 库）=====
# MySQL DSN：user:password@tcp(host:port)/easytv?charset=utf8mb4&parseTime=True&loc=Local
# 必填：缺失 SQL_DSN 时服务启动失败
SQL_DSN=user:password@tcp(127.0.0.1:3306)/easytv?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai&tls=false&timeout=30s&readTimeout=60s&writeTimeout=60s
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=1000

# 建库语句（首次需手动执行或用本服务迁移）：
#   CREATE DATABASE IF NOT EXISTS easytv DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

# ===== Redis =====
REDIS_CONN_STRING=redis://:password@127.0.0.1:6379/0

# ===== 会话/安全 =====
# CRYPTO_SECRET：校验码 HMAC 密钥。生产环境必填且建议 >= 32 位随机字符串（生成：openssl rand -hex 32），
# 未设置或过短时生产模式（非 DEBUG）启动失败，仅开发模式可降级。
CRYPTO_SECRET=please-change-me-to-a-long-random-string
# 邮箱验证码过期分钟
VERIFICATION_VALID_MINUTES=10

# ===== root 超级管理员（首次启动创建）=====
# 必填：系统无管理员且未设置 ROOT_PASSWORD 时拒绝启动（不再存在默认 admin/admin123456）。
ROOT_USERNAME=admin
ROOT_PASSWORD=please-set-a-strong-password

# ===== 登录渠道开关 =====
# 邮箱验证码是否走真实 SMTP；false 时验证码打印到日志便于联调
EMAIL_VERIFICATION_ENABLED=false
# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=EasyTV <noreply@example.com>

# 微信开放平台（扫码登录）回调域名
# WECHAT_OAUTH_REDIRECT_DOMAIN=

# ===== CORS =====
# 无条件放行所有跨域来源（回显 Origin + 允许凭据），无需配置

# ===== 套餐额度（未开通会员的默认额度，见 service/quota.go）=====
FREE_CONCURRENT=1
FREE_STORAGE_GB=2

# ===== 支付（商户配置到 DB setting 表，见 README；此处仅占位说明）=====
# 微信支付 Native
WECHATPAY_APPID=
WECHATPAY_MCHID=
WECHATPAY_MCH_SERIALNO=
WECHATPAY_APIv3KEY=
# 支付宝（真实配置在 setting 表）
ALIPAY_APPID=

# ===== EasyAPI 大模型网关（画布生成任务全部经此网关，见 API.md 1.4）=====
# 已迁移为 DB setting 表配置（管理端 GET/PUT /admin/gateway/config 热更新）：
#   EasyAPIGatewayBaseUrl / EasyAPIGatewayKey / EasyAPIGatewayEnabled
#   UploadBaseUrl（上传文件对外前缀）
#   模型清单由 model_price 表单一管理：管理端 /admin/gateway/fetch-models 从网关拉取后
#   经 /admin/gateway/models/import 导入（含建议积分：成本×毛利系数×积分/元，可调）
# 下方 env 保留仅为存量部署首次启动迁移（model_price 为空时按清单补种），运行期不再生效。
EASYAPI_BASE_URL=https://api.easyapi.com
EASYAPI_KEY=
EASYAPI_TEXT_MODELS=gpt-4o-mini:GPT-4o mini,deepseek-chat:DeepSeek V3
EASYAPI_IMAGE_MODELS=gpt-image-1:GPT Image 1,flux-schnell:Flux Schnell
EASYAPI_VIDEO_MODELS=kling-v1:可灵 1.0,jimeng_vgfm_t2v_l20:即梦 T2V
EASYAPI_AUDIO_MODELS=tts-1:TTS 1
# 本地上传文件对外地址（图生视频需要网关能访问到素材）；等同 UploadBaseUrl 缺省。
UPLOAD_BASE_URL=

# ===== 七牛云（可选，配置 QiniuAccessKey/QiniuSecretKey 到 setting 即启用，见 /admin/gateway/config）=====
# 启用后：/user/asset/upload 与生成产物直传七牛 CDN（公网 URL，图生视频素材无需再配 UPLOAD_BASE_URL）；
# 前端直传凭证：GET /user/qiniu/upload-token、GET /user/qiniu/key（UserAuth）。
# QiniuAccessKey / QiniuSecretKey / QiniuBucketName(easyapi) / QiniuProjectCode(easytv) / QiniuDomain

# ===== 阿里云 OSS（配置 OSS_BUCKET 即启用上传直接写 OSS；留空走本地 upload/）=====
# 生产环境请使用最小权限子账号（仅允许 PutObject/GetObject 到目标桶）
OSS_BUCKET=your-bucket
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BASE_URL=https://your-cdn-domain.com
OSS_PREFIX=easytv
OSS_PUBLIC_READ=false

# ===== 媒体工具（画布工具条的裁切 / 截取 / 分离 / 抽帧等，见 API.md 23）=====
# ffmpeg / ffprobe 装在 PATH 里即可；不在 PATH 或想固定版本时填绝对路径。
# 也可以改 setting（FFmpegPath / FFprobePath，管理端热更新，优先于这两个环境变量）。
FFMPEG_PATH=
FFPROBE_PATH=